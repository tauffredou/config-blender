# Build output (task build, task docker:*)
/bin/

# Generated by task webui:build — go:embed requires this directory to
# exist and be non-empty at compile time, so it's regenerated by the
# Taskfile rather than committed.
/internal/centralserver/ui/*
!/internal/centralserver/ui/.gitkeep

# webui/ has its own .gitignore (node_modules, dist, editor files)

# Task's local run cache
/.task/
